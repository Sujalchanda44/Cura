# ==========================================
# HealthSync AI Server Environment Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_ACCESS_SECRET=healthsync_jwt_super_secret_access_key_2026_x89!#
JWT_REFRESH_SECRET=healthsync_jwt_super_secret_refresh_key_2026_y72!$
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# AI Configuration (Google Gemini)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenFoodFacts API
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# File Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
